# Porta 8443 porque a 443 do IP público do CTISM já é de outro serviço; o Cloudflare
# recebe o visitante na 443 e conecta aqui na 8443 (Origin Rules). O prefixo `http://`
# é obrigatório: sem ele o Caddy liga o HTTPS automático, tenta emitir certificado no
# Let's Encrypt e falha em laço, porque o desafio ACME exige a porta 80 vinda da internet.
http://api.hortasurbanassm.com.br:8443 {
	reverse_proxy api:8000
}

http://app.hortasurbanassm.com.br:8443 {
	root * /srv/app
	encode gzip

	# Cache (doc de deploy do vite-plugin-pwa): assets têm hash no nome, podem
	# ser cacheados para sempre; index.html/sw.js mantêm o nome e precisam ser
	# revalidados a cada visita, senão o auto-update do PWA atrasa.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@nohash not path /assets/*
	header @nohash Cache-Control "no-cache"

	try_files {path} {path}.html /index.html
	file_server
}
