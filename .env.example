# Chave secreta para assinar os tokens JWT.
# Este valor já funciona para rodar local. Em PRODUÇÃO, troque por uma chave
# própria (gere com: openssl rand -hex 32).
SECRET_KEY=dev-secret-troque-em-producao-0123456789abcdef0123456789abcdef

# Algoritmo de assinatura JWT
ALGORITHM=HS256

# Tempo de expiração do access token em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dias sem uso até o refresh token expirar (o usuário é deslogado)
REFRESH_TOKEN_EXPIRE_DAYS=60

# --- Banco de dados ---
# DEV (docker-compose.yaml): a porta 5435 do host mapeia a 5432 do container.
DATABASE_URL=postgresql://horta:horta1234@localhost:5435/horta_db
#
# PRODUÇÃO (docker-compose.prod.yaml): a API fala com o banco pelo NOME do serviço
# na rede interna do compose (host `db`, porta 5432 — sem mapear porta p/ fora).
# Troque a senha e use o MESMO valor em POSTGRES_PASSWORD abaixo:
#   DATABASE_URL=postgresql://horta:SENHA_FORTE@db:5432/horta_db
#
# Lidas só pelo serviço `db` no compose de produção (interpolação automática a
# partir deste .env). A senha precisa bater com a do DATABASE_URL.
POSTGRES_USER=horta
POSTGRES_PASSWORD=horta1234
POSTGRES_DB=horta_db

# --- CORS — origens permitidas ---
# Precisa ser EXATO: esquema + host (+ porta). Inclua TODA origem que chama a API:
#  - Web em produção (Caddy serve o frontend):  https://app.hortasurbanassm.com.br
#  - APK Android (Capacitor com assets embarcados, androidScheme "https"):
#    https://localhost — só necessário se o APK NÃO usar server.url
#  - (dev web local com Vite, se precisar:      http://localhost:5173)
CORS_ORIGINS=["https://localhost", "https://app.hortasurbanassm.com.br"]

# Cloudflare R2 (fotos do fórum). Os valores ficam no painel do Cloudflare.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME="urbangardens"
# URL pública do bucket. No início usamos o r2.dev (Public Development URL do bucket):
#   R2_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev
# r2.dev é rate-limited (uso não-produção pela Cloudflare); ok p/ baixa escala.
# Quando escalar, troque por um custom domain (cache/WAF) — só muda este valor.
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev
