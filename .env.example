# Chave secreta para assinar os tokens JWT (gere com: openssl rand -hex 32)
SECRET_KEY=sua_chave_secreta_aqui

# Algoritmo de assinatura JWT
ALGORITHM=HS256

# Tempo de expiração do access token em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dias sem uso até o refresh token expirar (o usuário é deslogado)
REFRESH_TOKEN_EXPIRE_DAYS=7

# URL de conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco
