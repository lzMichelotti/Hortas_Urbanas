# Chave secreta para assinar os tokens JWT.
# Este valor já funciona para rodar local. Em PRODUÇÃO, troque por uma chave
# própria (gere com: openssl rand -hex 32).
SECRET_KEY=dev-secret-troque-em-producao-0123456789abcdef0123456789abcdef

# Algoritmo de assinatura JWT
ALGORITHM=HS256

# Tempo de expiração do access token em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dias sem uso até o refresh token expirar (o usuário é deslogado)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Conexão com o banco do docker-compose (porta 5435 -> 5432 do container).
# Já vem pronto para o docker-compose.yaml deste repositório.
DATABASE_URL=postgresql://horta:horta1234@localhost:5435/horta_db

# Em desenvolvimento: porta do seu frontend (Vite=5173, CRA=3000, etc.)
# Em produção: domínio real (ex: ["https://meusite.com"])
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
