<?xml version="1.0" encoding="utf-8"?>
<!-- Em Android 12+, allowBackup=false nao barra a transferencia entre aparelhos:
     dai as duas secoes. O WebView guarda tokens e dados de outros membros. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
